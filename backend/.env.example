# Copy to `.env` and fill in real values. Never commit the real .env.
DATABASE_URL=postgresql://hormoneos:hormoneos@localhost:5432/hormoneos
HSF_MODEL_VERSION=hsf-v1
EMBEDDING_DIM=128
UPLOAD_DIR=/tmp/hormoneos_uploads

# Comma-separated list of allowed CORS origins. Use "*" only for local dev.
CORS_ORIGINS=http://localhost:3000

# Optional: enables GPT-4o narratives. Leave blank to disable gracefully.
OPENAI_API_KEY=
